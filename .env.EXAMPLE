# Create a .env.development and a .env.production file
# with the following keys.
# Do NOT check these files into source control

# Contentful Configuration
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""
CONTENTFUL_HOST=""

# WordPress Configuration
WPGRAPHQL_URL="https://your-wordpress-site.com/graphql"
WP_USERNAME="your_wp_username"
WP_PASSWORD="your_wp_password"
WP_CONSUMER_KEY="your_consumer_key"
WP_CONSUMER_SECRET="your_consumer_secret"

# WordPress Additional Settings
WP_API_URL="https://your-wordpress-site.com/wp-json/wp/v2"
WP_PREVIEW_SECRET="your_preview_secret_key"

# Shopify Configuration (Phase 1 E-commerce)
