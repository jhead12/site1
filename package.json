{
  "name": "jeldon-music",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "gatsby develop",
    "develop": "gatsby develop",
    "develop:wp": "gatsby develop --verbose",
    "develop:ssl-bypass": "BYPASS_WORDPRESS=true gatsby develop",
    "develop:mock": "bash ./scripts/enable-ssl-bypass.sh && BYPASS_WORDPRESS=true gatsby develop",
    "ensure-dirs": "node ./scripts/ensure-directories.js",
    "build": "yarn ensure-dirs && gatsby build",
    "build:netlify": "yarn ensure-dirs && gatsby build",
    "build:no-wp": "yarn ensure-dirs && BYPASS_WORDPRESS=true gatsby build",
    "build:analyze": "ANALYZE=true gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "clean:wp": "gatsby clean && rm -rf wordpress-graphql-queries",
    "gatsby-provision": "gatsby-provision-contentful --contentful-data-path='./scripts/data.json' --space-id=$CONTENTFUL_SPACE_ID --management-token=$CONTENTFUL_MANAGEMENT_TOKEN",
    "setup": "node ./scripts/setup.js",
    "setup:wp": "node ./scripts/wordpress-setup.js",
    "setup:bypass": "bash ./scripts/enable-ssl-bypass.sh",
    "setup:blog-model": "node ./scripts/setup-blog-content-model.js",
    "sync:youtube": "node ./scripts/sync-youtube-to-videos.js",
    "sync:youtube:dry-run": "node ./scripts/sync-youtube-to-videos.js --dry-run",
    "setup:video-model": "node ./scripts/setup-video-content-model.js",
    "export-content": "contentful space export --space-id=$SPACE_ID --management-token=$MANAGEMENT_TOKEN --export-dir=scripts --content-file=data.json",
    "backup-and-provision": "node ./scripts/backup-and-provision.js",
    "backup:create": "node ./scripts/backup-and-provision.js",
    "backup:dry-run": "node ./scripts/backup-and-provision.js --dry-run",
    "video:verify": "node ./scripts/verify-video-setup.js",
    "video:setup-check": "node ./scripts/verify-video-setup.js",
    "wp:test-connection": "node ./scripts/test-wp-connection.js",
    "wp:sync": "node ./scripts/sync-wp-content.js",
    "wp:import-acf": "node ./scripts/import-acf-fields.js",
    "wp:fix-taxonomy": "node ./scripts/fix-taxonomy-issues.js",
    "wp:setup-about": "bash ./scripts/setup-about-page.sh",
    "status": "bash ./scripts/check-build-status.sh",
    "warnings:check": "bash ./scripts/check-warnings-status.sh",
    "blog:test": "bash ./scripts/test-blog-integration.sh",
    "blog:debug": "bash ./scripts/debug-blog-connection.sh",
    "about:check": "node ./scripts/check-about-page.js",
    "setup:phase3": "bash ./scripts/setup-phase-3.sh",
    "hero:develop": "BYPASS_WORDPRESS=true gatsby develop",
    "hero:build": "BYPASS_WORDPRESS=true gatsby build",
    "graphql:inspect": "node ./scripts/inspect-graphql-schema.js",
    "graphql:cleanup": "node ./scripts/cleanup-schema.js",
    "graphql:monitor": "bash ./scripts/monitor-graphql.sh",
    "graphql:monitor-watch": "bash ./scripts/monitor-graphql.sh --monitor",
    "inspect:contentful": "node ./scripts/inspect-contentful.js",
    "inspect:all": "npm run graphql:inspect && npm run inspect:contentful",
    "data:debug": "npm run inspect:all && npm run wp:test-connection",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^15.11.1",
    "@fontsource/dm-mono": "^4.5.9",
    "@fontsource/dm-sans": "^4.5.8",
    "@vanilla-extract/babel-plugin": "^1.2.0",
    "@vanilla-extract/css": "^1.9.0",
    "@vanilla-extract/css-utils": "^0.1.2",
    "@vanilla-extract/webpack-plugin": "^2.3.15",
    "encoding": "^0.1.13",
    "gatsby": "^5.0.0",
    "gatsby-adapter-netlify": "^1.0.4",
    "gatsby-plugin-gdpr-cookies": "^2.0.9",
    "gatsby-plugin-google-gtag": "^5.14.0",
    "gatsby-plugin-i18n": "^1.0.1",
    "gatsby-plugin-image": "^3.0.0",
    "gatsby-plugin-manifest": "^5.0.0",
    "gatsby-plugin-sharp": "^5.0.0",
    "gatsby-plugin-vanilla-extract": "^4.0.1",
    "gatsby-source-contentful": "^8.13.2",
    "gatsby-source-filesystem": "^5.0.0",
    "gatsby-source-shopify": "^10.0.0",
    "gatsby-source-wordpress": "^7.15.0",
    "gatsby-transformer-sharp": "^5.0.0",
    "graphql": "^16.10.0",
    "gsap": "^3.14.2",
    "is-absolute-url": "^4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-feather": "^2.0.9",
    "react-helmet": "^6.1.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^29.0.0",
    "chalk": "4",
    "contentful-cli": "^1.15.3",
    "contentful-import": "^8.3.2",
    "dotenv": "^16.0.3",
    "gatsby-provision-contentful": "^0.0.5",
    "husky": "^7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "inquirer": "^8.2.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "lint-staged": "^12.3.5",
    "node-fetch": "^2.6.7",
    "prettier": "2.5.1",
    "yargs-parser": "^21.0.0"
  }
}
