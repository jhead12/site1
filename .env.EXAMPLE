# Create a .env.development and a .env.production file
# with the following keys.
# Do NOT check these files into source control

# Contentful Configuration
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""
CONTENTFUL_HOST=""

# Contentful Management (used by scripts/setup-blog-content-model.js and the
# YouTube→Contentful sync script). Get it from Contentful > Settings > API Keys >
# Content management tokens.
CONTENTFUL_MANAGEMENT_TOKEN=""
CONTENTFUL_ENV="master"

# Giscus comments (GitHub Discussions-backed). Generate at https://giscus.app
# after enabling Discussions on your repo and installing the Giscus app.
GATSBY_GISCUS_REPO=""
GATSBY_GISCUS_REPO_ID=""
GATSBY_GISCUS_CATEGORY=""
GATSBY_GISCUS_CATEGORY_ID=""
GATSBY_GISCUS_MAPPING="pathname"
GATSBY_GISCUS_THEME="dark_dimmed"

# YouTube → Contentful blog sync (scripts/sync-youtube-to-contentful.js)
# Get an API key at Google Cloud Console with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""
YOUTUBE_SYNC_LIMIT="10"
YOUTUBE_AUTHOR="Jeldon"
# Optional: slug of an existing Blog Category to tag synced posts with.
YOUTUBE_CATEGORY_SLUG=""
# Set to "true" to skip uploading the YouTube thumbnail as the featured image.
YOUTUBE_SKIP_IMAGE=""

# Digital product config sync (scripts/sync-product-map-to-s3.js)
# Publishes Contentful "Digital Product" entries to
# s3://jeldonmusic-s3-bucket/config/product-map.json, which the presign
# Lambda reads instead of a hardcoded map. Uses CONTENTFUL_SPACE_ID/
# CONTENTFUL_ACCESS_TOKEN above, plus a DEDICATED IAM user scoped to
# s3:PutObject on ONLY that one object key - never reuse a general AWS key.
PRODUCT_MAP_AWS_ACCESS_KEY_ID=""
PRODUCT_MAP_AWS_SECRET_ACCESS_KEY=""
PRODUCT_MAP_AWS_REGION="us-west-2"
PRODUCT_MAP_S3_BUCKET="jeldonmusic-s3-bucket"
PRODUCT_MAP_S3_KEY="config/product-map.json"

# WordPress Configuration
WPGRAPHQL_URL="https://your-wordpress-site.com/graphql"
WP_USERNAME="your_wp_username"
WP_PASSWORD="your_wp_password"
WP_CONSUMER_KEY="your_consumer_key"
WP_CONSUMER_SECRET="your_consumer_secret"

# WordPress Additional Settings
WP_API_URL="https://your-wordpress-site.com/wp-json/wp/v2"
WP_PREVIEW_SECRET="your_preview_secret_key"

# Media CDN (for future use)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Search (for Phase 4)
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
ALGOLIA_SEARCH_KEY=""

# Tawk.to Live Chat Configuration
# Get these from your Tawk.to dashboard: Admin > Chat Widget > Direct Chat Link
# The URL format is: https://tawk.to/chat/PROPERTY_ID/WIDGET_ID
GATSBY_TAWKTO_PROPERTY_ID=""
GATSBY_TAWKTO_WIDGET_ID="default"

# Amazon Connect Configuration
# Create an Amazon Connect instance and get these values from the AWS Console
GATSBY_AMAZON_CONNECT_INSTANCE_ID=""
GATSBY_AMAZON_CONNECT_CONTACT_FLOW_ID=""
GATSBY_AMAZON_CONNECT_PHONE_NUMBER=""
GATSBY_AMAZON_CONNECT_REGION="us-east-1"

