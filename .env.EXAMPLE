# Create a .env.development and a .env.production file
# with the following keys.
# Do NOT check these files into source control

# Contentful Configuration
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""
CONTENTFUL_HOST=""

# WordPress Configuration
WPGRAPHQL_URL="https://your-wordpress-site.com/graphql"
WP_USERNAME="your_wp_username"
WP_PASSWORD="your_wp_password"
WP_CONSUMER_KEY="your_consumer_key"
WP_CONSUMER_SECRET="your_consumer_secret"

# WordPress Additional Settings
WP_API_URL="https://your-wordpress-site.com/wp-json/wp/v2"
WP_PREVIEW_SECRET="your_preview_secret_key"

# Media CDN (for future use)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Search (for Phase 4)
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
ALGOLIA_SEARCH_KEY=""

# Tawk.to Live Chat Configuration
# Get these from your Tawk.to dashboard: Admin > Chat Widget > Direct Chat Link
# The URL format is: https://tawk.to/chat/PROPERTY_ID/WIDGET_ID
GATSBY_TAWKTO_PROPERTY_ID=""
GATSBY_TAWKTO_WIDGET_ID="default"

# Amazon Connect Configuration
# Create an Amazon Connect instance and get these values from the AWS Console
GATSBY_AMAZON_CONNECT_INSTANCE_ID=""
GATSBY_AMAZON_CONNECT_CONTACT_FLOW_ID=""
GATSBY_AMAZON_CONNECT_PHONE_NUMBER=""
GATSBY_AMAZON_CONNECT_REGION="us-east-1"

